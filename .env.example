# Copy to .env.local and fill in. The app boots without these (demo mode:
# bundled sweet demo deck, no sign-in, no cloud saves) — see README.

# Convex deployment URL — printed by `bun run dev:convex` on first run
VITE_CONVEX_URL=

# Clerk (https://dashboard.clerk.com → API keys). Enable Google + Apple
# OAuth only — no email/password (PRD §6.1). Set BOTH keys or NEITHER —
# a half-configured pair fails fast at server boot (src/start.ts).
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# PostHog project API key (https://us.posthog.com → Project settings). Optional:
# without it no analytics code runs. Content-free allow-list only (PRD §6.9,
# src/lib/analytics/events.ts) — cookieless, no autocapture, no replay.
# Recommended project setting: "Discard client IP data".
VITE_POSTHOG_KEY=

# NOT read from this file: CLERK_JWT_ISSUER_DOMAIN must be set in the
# Convex dashboard (Deployment Settings → Environment Variables), because
# Convex functions run on Convex's servers. Value = your Clerk Frontend API
# URL, e.g. https://verb-noun-00.clerk.accounts.dev (dev) or
# https://clerk.jrny.app (prod). See convex/auth.config.ts.
